{# this file is meant as a catch-all location for consumers to provide overrides without having to override specific parts #}

/* OpenCart 4 only banner */
.ka-oc4-banner {
    margin: 0 auto;
    max-width: var(--container-width, 1400px);
    padding: .75rem 1rem;
    background: #f3eafb;
    border: 1px solid #c9a7e8;
    border-radius: 3px;
    color: #4a2470;
    font-weight: 600;
    text-align: center;
}
